{
  "triggers": [
    {
      "id": "area_mode_changed",
      "title": { "en": "Alarm mode changed" },
      "tokens": [
        { "name": "mode", "type": "string", "title": { "en": "Mode" }, "example": { "en": "full" } }
      ]
    }
  ],
  "conditions": [
    {
      "id": "area_mode_is",
      "title": { "en": "Alarm mode !{{is|is not}}" },
      "titleFormatted": { "en": "Alarm mode !{{is|is not}} [[mode]]" },
      "args": [
        { "type": "dropdown", "name": "mode", "title": { "en": "Mode" }, "values": [
          { "id": "disarmed", "label": { "en": "Disarmed" } },
          { "id": "stay", "label": { "en": "Stay armed" } },
          { "id": "sleep", "label": { "en": "Sleep armed" } },
          { "id": "full", "label": { "en": "Full armed" } },
          { "id": "alarm", "label": { "en": "In alarm" } }
        ] }
      ]
    },
    {
      "id": "area_is_ready",
      "title": { "en": "Area !{{is|is not}} ready to arm" }
    }
  ],
  "actions": [
    {
      "id": "area_set_mode",
      "title": { "en": "Set alarm mode" },
      "titleFormatted": { "en": "Set alarm mode to [[mode]]" },
      "args": [
        { "type": "dropdown", "name": "mode", "title": { "en": "Mode" }, "values": [
          { "id": "disarmed", "label": { "en": "Disarm" } },
          { "id": "stay", "label": { "en": "Stay arm" } },
          { "id": "sleep", "label": { "en": "Sleep arm" } },
          { "id": "full", "label": { "en": "Full arm" } }
        ] }
      ]
    },
    {
      "id": "area_set_mode_as",
      "title": { "en": "Set alarm mode as a person" },
      "titleFormatted": { "en": "Set alarm mode to [[mode]] as [[who]]" },
      "hint": { "en": "Same as \"Set alarm mode\", but the timeline says who did it. Use the Name tag of a presence trigger (e.g. \"Someone left home\") or type a name." },
      "args": [
        { "type": "dropdown", "name": "mode", "title": { "en": "Mode" }, "values": [
          { "id": "disarmed", "label": { "en": "Disarm" } },
          { "id": "stay", "label": { "en": "Stay arm" } },
          { "id": "sleep", "label": { "en": "Sleep arm" } },
          { "id": "full", "label": { "en": "Full arm" } }
        ] },
        { "type": "text", "name": "who", "title": { "en": "Who" }, "placeholder": { "en": "e.g. Name tag" } }
      ]
    },
    {
      "id": "area_beep",
      "title": { "en": "Make the panel beep" }
    },
    {
      "id": "area_pgm",
      "title": { "en": "Switch a PGM output" },
      "titleFormatted": { "en": "Switch PGM [[pgm]] [[state]]" },
      "args": [
        { "type": "number", "name": "pgm", "title": { "en": "PGM" }, "min": 1, "max": 16, "step": 1, "placeholder": { "en": "1-16" } },
        { "type": "dropdown", "name": "state", "title": { "en": "State" }, "values": [
          { "id": "on", "label": { "en": "on" } },
          { "id": "off", "label": { "en": "off" } }
        ] }
      ]
    }
  ]
}
